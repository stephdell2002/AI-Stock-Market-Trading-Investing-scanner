# Watchman API keys — copy to .env (gitignored) or export in your shell.
# Keys are read from the environment ONLY. Never put keys in YAML or code.
#
# None of these are required for v1: the default provider is yfinance (free, EOD).
# Fill one in later to unlock real-time/intraday data for Module B.

# https://polygon.io  (real-time + intraday bars)
WATCHMAN_POLYGON_KEY=

# https://finnhub.io  (real-time quotes, news)
WATCHMAN_FINNHUB_KEY=

# https://financialmodelingprep.com  (deep fundamentals)
WATCHMAN_FMP_KEY=
