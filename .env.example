# Watchman API keys — copy to .env (gitignored) or export in your shell.
# Keys are read from the environment ONLY. Never put keys in YAML or code.
#
# None of these are required for v1: the default provider is yfinance (free, EOD).
# Add a key AND set `data.provider` in config/settings.yaml to that source to
# unlock real-time / intraday data for Module B. See docs/realtime-data.md.

# https://polygon.io  — clean intraday bars; free tier delayed, paid real-time.
# Use with:  data.provider: polygon   (fundamentals fall back to yfinance)
WATCHMAN_POLYGON_KEY=

# https://finnhub.io  — real-time quotes + news (free); intraday candles paid.
# Use with:  data.provider: finnhub
WATCHMAN_FINNHUB_KEY=

# https://financialmodelingprep.com  — bars + deep fundamentals + statements.
# Use with:  data.provider: fmp       (drives screener AND signals on its own)
WATCHMAN_FMP_KEY=
